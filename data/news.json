---
layout: null
---
{%- assign entries = site.data.articles | sort -%}
{%- assign latest = '' -%}
{%- for entry in entries -%}
  {%- assign article = entry[1] -%}
  {%- assign changed = article.revised | default: article.date -%}
  {%- if changed > latest -%}{%- assign latest = changed -%}{%- endif -%}
{%- endfor -%}
{"updated":{{ latest | jsonify }},"items":[{%- for entry in entries -%}{{ entry[1] | jsonify }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
